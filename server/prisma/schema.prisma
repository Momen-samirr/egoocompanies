generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model user {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  name              String?
  phone_number      String   @unique
  email             String?  @unique
  notificationToken String?
  ratings           Float    @default(0)
  totalRides        Float    @default(0)
  cratedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt
  rides             rides[]  @relation("UserRides")
}

enum VehicleType {
  Car
  Motorcycle
  CNG
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  COMPANY
}

model Admin {
  id                  String              @id @default(auto()) @map("_id") @db.ObjectId
  email               String              @unique
  password            String
  name                String
  role                AdminRole           @default(ADMIN)
  companyId           String?             @db.ObjectId
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  createdTrips        ScheduledTrip[]     @relation("CreatedBy")
  company             Company?            @relation("CompanyAccounts", fields: [companyId], references: [id])
  statusChangeHistory TripStatusHistory[] @relation("StatusChangeHistory")
  createdTemplates    TripTemplate[]      @relation("CreatedTemplates")
}

model driver {
  id                   String                @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  country              String
  phone_number         String                @unique
  email                String                @unique
  vehicle_type         VehicleType
  registration_number  String                @unique
  registration_date    String
  driving_license      String
  vehicle_color        String?
  rate                 String
  notificationToken    String?
  ratings              Float                 @default(0)
  totalEarning         Float                 @default(0)
  scheduledTripBalance Float                 @default(0)
  totalRides           Float                 @default(0)
  pendingRides         Float                 @default(0)
  cancelRides          Float                 @default(0)
  status               String                @default("inactive")
  selfiePhoto          String?
  driversLicensePhoto  String?
  driversLicensePhotos Json? // Array: [{side: "front", url: string}, {side: "back", url: string}]
  criminalRecordPhoto  String?
  drugTestPhoto        String?
  documentStatuses     Json? // Individual document status tracking
  documentsVerified    Boolean               @default(false)
  documentsVerifiedAt  DateTime?
  documentsVerifiedBy  String?               @db.ObjectId
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  rides                rides[]               @relation("DriverRides")
  assignedTrips        ScheduledTrip[]       @relation("AssignedCaptain")
  emergencyUsages      EmergencyUsage[]      @relation("DriverEmergencyUsages")
  scheduledTripLedger  ScheduledTripLedger[] @relation("LedgerCaptain")
  companies            DriverCompany[]
  templateAssignments  TripTemplate[]        @relation("TemplateCaptain")
  notifications        AdminNotification[]   @relation("DriverNotifications")
}

model EmergencyUsage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId  String   @db.ObjectId
  tripId    String   @db.ObjectId
  usedAt    DateTime @default(now())
  createdAt DateTime @default(now())
  driver    driver   @relation("DriverEmergencyUsages", fields: [driverId], references: [id])
}

enum ScheduledTripStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
  EMERGENCY_TERMINATED
  EMERGENCY_ENDED
  FORCE_CLOSED
}

enum ScheduledTripFinancialStatus {
  NONE
  PAID
  PENALIZED
}

enum ScheduledTripFinancialRule {
  NONE
  COMPLETED_FULL
  FAILED_DOUBLE
  EMERGENCY_DEDUCTION
  FORCE_CLOSED_DEDUCTION
}

enum TripType {
  ARRIVAL
  DEPARTURE
}

enum StopType {
  PICKUP
  DROP_OFF
  FINAL_STOP
}

enum NotificationType {
  DOCUMENT_UPLOAD
  DOCUMENT_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
}

model Company {
  id                        String          @id @default(auto()) @map("_id") @db.ObjectId
  name                      String
  defaultScheduledTripPrice Float
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  scheduledTrips            ScheduledTrip[]
  drivers                   DriverCompany[]
  companyAccounts           Admin[]         @relation("CompanyAccounts")
  tripTemplates             TripTemplate[]
}

model DriverCompany {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId  String   @db.ObjectId
  companyId String   @db.ObjectId
  driver    driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([driverId, companyId])
}

model ScheduledTrip {
  id                    String                       @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  tripDate              DateTime
  scheduledTime         DateTime
  status                ScheduledTripStatus          @default(SCHEDULED)
  tripType              TripType                     @default(DEPARTURE)
  assignedCaptainId     String?                      @db.ObjectId
  createdById           String                       @db.ObjectId
  companyId             String?                      @db.ObjectId
  routeId               String?                      @db.ObjectId
  price                 Float?                       @default(0)
  financialStatus       ScheduledTripFinancialStatus @default(NONE)
  financialRule         ScheduledTripFinancialRule   @default(NONE)
  financialAdjustment   Float                        @default(0)
  netAmount             Float                        @default(0)
  financialAppliedAt    DateTime?
  emergencyTerminatedAt DateTime?
  emergencyTerminatedBy String?                      @db.ObjectId
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  assignedCaptain       driver?                      @relation("AssignedCaptain", fields: [assignedCaptainId], references: [id])
  createdBy             Admin                        @relation("CreatedBy", fields: [createdById], references: [id])
  company               Company?                     @relation(fields: [companyId], references: [id])
  route                 Route?                       @relation(fields: [routeId], references: [id])
  points                TripPoint[]
  progress              TripProgress?
  activationChecks      TripActivationCheck[]
  ledgerEntries         ScheduledTripLedger[]
  statusHistory         TripStatusHistory[]          @relation("TripStatusHistory")
  locationHistory       TripLocationHistory[]
}

model TripPoint {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  scheduledTripId String        @db.ObjectId
  name            String
  latitude        Float
  longitude       Float
  order           Int
  isFinalPoint    Boolean       @default(false)
  stopId          String?       @db.ObjectId
  expectedTime    DateTime?
  reachedAt       DateTime?
  employees       Json? // Array of { name: string, employeeId?: string }
  scheduledTrip   ScheduledTrip @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)
  stop            Stop?         @relation(fields: [stopId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model TripProgress {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  scheduledTripId    String        @unique @db.ObjectId
  captainId          String        @db.ObjectId
  currentPointIndex  Int           @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  lastLocationUpdate DateTime?
  lastLatitude       Float?
  lastLongitude      Float?
  scheduledTrip      ScheduledTrip @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model TripActivationCheck {
  id                   String        @id @default(auto()) @map("_id") @db.ObjectId
  scheduledTripId      String        @db.ObjectId
  captainId            String        @db.ObjectId
  checkedAt            DateTime      @default(now())
  wasWithinProximity   Boolean       @default(false)
  wasOnTime            Boolean       @default(false)
  activated            Boolean       @default(false)
  captainLatitude      Float?
  captainLongitude     Float?
  distanceToFirstPoint Float?
  scheduledTrip        ScheduledTrip @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)
  createdAt            DateTime      @default(now())
}

model ScheduledTripLedger {
  id                  String                     @id @default(auto()) @map("_id") @db.ObjectId
  scheduledTripId     String                     @db.ObjectId
  captainId           String                     @db.ObjectId
  baseAmount          Float                      @default(0)
  adjustmentAmount    Float                      @default(0)
  netAmount           Float                      @default(0)
  rule                ScheduledTripFinancialRule @default(NONE)
  statusAtCalculation ScheduledTripStatus
  calculatedAt        DateTime                   @default(now())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  scheduledTrip       ScheduledTrip              @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)
  captain             driver                     @relation("LedgerCaptain", fields: [captainId], references: [id])
}

model TripStatusHistory {
  id              String              @id @default(auto()) @map("_id") @db.ObjectId
  scheduledTripId String              @db.ObjectId
  previousStatus  ScheduledTripStatus
  newStatus       ScheduledTripStatus
  note            String?
  deduction       Float?
  changedBy       String              @db.ObjectId
  changedAt       DateTime            @default(now())
  scheduledTrip   ScheduledTrip       @relation("TripStatusHistory", fields: [scheduledTripId], references: [id], onDelete: Cascade)
  changedByAdmin  Admin               @relation("StatusChangeHistory", fields: [changedBy], references: [id])

  @@index([scheduledTripId])
  @@index([changedAt])
}

model TripTemplate {
  id                String              @id @default(auto()) @map("_id") @db.ObjectId
  name              String // Template name
  description       String? // Optional description
  companyId         String?             @db.ObjectId
  tripType          TripType            @default(DEPARTURE)
  assignedCaptainId String?             @db.ObjectId
  createdById       String              @db.ObjectId
  price             Float?              @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  createdBy         Admin               @relation("CreatedTemplates", fields: [createdById], references: [id])
  company           Company?            @relation(fields: [companyId], references: [id])
  assignedCaptain   driver?             @relation("TemplateCaptain", fields: [assignedCaptainId], references: [id])
  points            TripTemplatePoint[]
}

model TripTemplatePoint {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  templateId   String       @db.ObjectId
  name         String
  latitude     Float
  longitude    Float
  order        Int
  isFinalPoint Boolean      @default(false)
  expectedTime String? // Stored as "HH:MM" format (time only, no date)
  employees    Json? // Array of { name: string, employeeId?: string }
  template     TripTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model rides {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  userId                  String   @db.ObjectId
  driverId                String   @db.ObjectId
  charge                  Float
  currentLocationName     String
  destinationLocationName String
  distance                String
  status                  String
  rating                  Float?
  user                    user     @relation("UserRides", fields: [userId], references: [id])
  driver                  driver   @relation("DriverRides", fields: [driverId], references: [id])
  cratedAt                DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model AdminNotification {
  id            String            @id @default(auto()) @map("_id") @db.ObjectId
  adminId       String?           @db.ObjectId  // null = all admins
  driverId      String            @db.ObjectId
  driver        driver            @relation("DriverNotifications", fields: [driverId], references: [id])
  type          NotificationType
  documentType  String            // "selfie", "license_front", "license_back", "drug_test", "criminal_record"
  status        NotificationStatus @default(UNREAD)
  readAt        DateTime?
  readBy        String?           @db.ObjectId
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  @@index([adminId, status])
  @@index([driverId])
  @@index([createdAt])
  @@index([documentType])
}

model DriverLocationHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  driverId  String   @db.ObjectId
  latitude  Float
  longitude Float
  heading   Float?
  accuracy  Float?
  speed     Float?
  timestamp DateTime @default(now())
  
  @@index([driverId, timestamp])
  @@index([timestamp])
  @@index([driverId])
}

model TripLocationHistory {
  id                      String        @id @default(auto()) @map("_id") @db.ObjectId
  scheduledTripId         String        @db.ObjectId
  driverId                String        @db.ObjectId
  latitude                 Float
  longitude                Float
  heading                  Float?
  accuracy                 Float?
  speed                    Float?         // Speed in m/s or km/h
  distanceFromRoute        Float?        // Distance from planned route in meters
  distanceFromNextCheckpoint Float?      // Distance to next checkpoint in meters
  etaToNextCheckpoint     Float?         // ETA to next checkpoint in minutes
  etaCalculatedAt         DateTime?      // When ETA was calculated
  etaMethod               String?        // 'google_maps' | 'simple_calculation'
  studentStopETAs         Json?          // Array of { stopId: string, etaMinutes: number, distanceMeters: number, method: string }
  timestamp                DateTime       @default(now())
  isCheckpointReached      Boolean        @default(false)
  checkpointIndex          Int?          // Which checkpoint was reached at this location
  isIdle                   Boolean        @default(false) // True if speed < threshold
  isRouteDeviation         Boolean        @default(false) // True if deviated from route
  
  scheduledTrip            ScheduledTrip  @relation(fields: [scheduledTripId], references: [id], onDelete: Cascade)
  
  @@index([scheduledTripId, timestamp])
  @@index([driverId, timestamp])
  @@index([timestamp])
  @@index([scheduledTripId, isRouteDeviation])
  @@index([scheduledTripId, isCheckpointReached])
}

// ==================== PARENT & STUDENT MODELS ====================

model Parent {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  phoneNumber       String?         @unique
  email             String?         @unique
  firstName         String
  lastName          String
  password          String
  verificationCode  String?
  isVerified        Boolean         @default(false)
  notificationToken String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  parentStudents    ParentStudent[]
}

model School {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  address   String?
  phoneNumber String?
  email     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  routes    Route[]
  students  Student[]
}

model Route {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String           @db.ObjectId
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  school      School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stops       Stop[]
  trips       ScheduledTrip[]
}

model Stop {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  routeId   String    @db.ObjectId
  name      String
  latitude  Float
  longitude Float
  order     Int
  stopType  StopType  @default(PICKUP)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  route     Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  students  Student[]
  tripPoints TripPoint[]
  
  @@index([routeId])
}

model Student {
  id           String          @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String          @db.ObjectId
  stopId       String?         @db.ObjectId
  firstName    String
  lastName     String
  grade        String?
  studentId    String?
  photo        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stop         Stop?           @relation(fields: [stopId], references: [id])
  parents      ParentStudent[]
  
  @@index([schoolId])
  @@index([stopId])
}

model ParentStudent {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  parentId     String   @db.ObjectId
  studentId    String   @db.ObjectId
  relationship String   // e.g., "parent", "guardian", "grandparent"
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}
